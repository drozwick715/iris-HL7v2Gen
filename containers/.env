##IRIS VERSION
export KITVERSION = 2025.1
export PRODUCT = irishealth
export IRISTAG=containers.intersystems.com/intersystems/${PRODUCT}:${KITVERSION}
export WEBGTAG=containers.intersystems.com/intersystems/webgateway:${KITVERSION}
export ISC_CPF_MERGE_FILE_NAME=\data\merge.cpf
export VOLUME=C:\data\containers  ## Bound to /data filesystem inside the container


